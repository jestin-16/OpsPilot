# Monitoring integrations. Copy to .env and adjust for the target cluster.
KUBERNETES_ENABLED=true
PROMETHEUS_ENABLED=true
PROMETHEUS_URL=http://localhost:9090
PROMETHEUS_USERNAME=
PROMETHEUS_PASSWORD=
LOKI_ENABLED=false
LOKI_URL=http://localhost:3100
LOKI_USERNAME=
LOKI_PASSWORD=

# Frontend & Public Ingress URL
VITE_API_BASE_URL=/api/v1
VITE_ENABLE_MOCK_DATA=false
OPSPILOT_PUBLIC_URL=https://opspilot.jestin16.dev

# Google OAuth
VITE_GOOGLE_CLIENT_ID=275211051077-gat8a3o8evorpt66b2lana97ktvj8mko.apps.googleusercontent.com
GOOGLE_CLIENT_ID=275211051077-gat8a3o8evorpt66b2lana97ktvj8mko.apps.googleusercontent.com
# AES-256-GCM key (any long random string) used to encrypt integration credentials,
# CI/CD source tokens and webhook secrets at rest. REQUIRED: the services refuse to start
# without it. Changing it makes previously stored secrets undecryptable.
# Generate with: openssl rand -base64 32
OPSPILOT_ENCRYPTION_KEY=

# Project log pipeline (observability-service)
LOGS_RUNNER_ENABLED=true
LOGS_RUNNER_INTERVAL_MS=30000
LOGS_RUNNER_REFRESH=10m
INGEST_MAX_BODY_BYTES=5242880

# Signs login tokens. REQUIRED: every backend service must use the same value, at least 32 bytes.
# Generate with: openssl rand -base64 48. Changing it signs everyone out.
JWT_SECRET=

# Creates the public demo accounts behind the login page's demo buttons (admin@opspilot.io etc.,
# password Password123!). Local development only; leave false on any shared deployment.
DEMO_USERS_ENABLED=false

# Refresh-token cookie is sent only over HTTPS. Set to false only for plain-HTTP local development.
AUTH_COOKIE_SECURE=true

# Shared secrets for the global webhook URLs (/api/webhooks/github, /api/v1/cicd/webhooks/github|jenkins).
# Left empty, those endpoints refuse every delivery (503); per-project and per-source webhook URLs use
# their own secrets and keep working.
GITHUB_WEBHOOK_SECRET=
JENKINS_WEBHOOK_SECRET=

# Grafana admin password. REQUIRED by docker-compose. Applied only when the grafana_data volume is first
# created; to change it later run: docker exec opspilot-grafana grafana cli admin reset-admin-password <new>
GRAFANA_ADMIN_PASSWORD=
